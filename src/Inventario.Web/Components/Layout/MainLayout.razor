@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Inventario.Web.Theme
@inject NavigationManager Nav

<MudThemeProvider Theme="AppTheme.Obtener()" />
<MudProviders />
<MudLayout>
    <MudAppBar Elevation="1" Style="background: linear-gradient(135deg, #1B3A1B 0%, #298B21 100%); color: #fff;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       OnClick="@ToggleDrawer" Edge="Edge.Start" />
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-center gap-2" style="margin-right: 8px;">
                    <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="mud-chip-avatar">@_iniciales</MudAvatar>
                    <div style="line-height:1.2;">
                        <div class="text-subtitle-2 lh-1" style="color:#fff;">@_nombre</div>
                        <div class="text-caption" style="color:rgba(255,255,255,.75);">@_rol</div>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                                   aria-label="Salir" Href="logout" />
                </div>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerAbierto"
               Variant="DrawerVariant.Temporary"
               ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader>
            <div class="d-flex align-center gap-2 px-1">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" />
                <div>
                    <div class="font-weight-bold text-subtitle-1 lh-1">Inventario</div>
                    <div class="text-caption mt-1" style="color:rgba(255,255,255,.55);">Energy-Minus · v1.0</div>
                </div>
            </div>
        </MudDrawerHeader>

        <NavMenu />

        <AuthorizeView>
            <NotAuthorized>
                <div class="px-3 pb-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="login">
                        Iniciar sesión
                    </MudButton>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </MudDrawer>

    <MudMainContent Class="pb-8">
        <MudContainer MaxWidth="MaxWidth.False" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerAbierto = false;

    private string _nombre = "Usuario";
    private string _rol = string.Empty;
    private string _iniciales = "U";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        if (AuthState is not null)
        {
            var estado = await AuthState;
            var principal = estado.User;
            if (principal.Identity?.IsAuthenticated == true)
            {
                _nombre = principal.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                          ?? principal.Identity.Name
                          ?? "Usuario";
                _rol = principal.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Consulta";
                _iniciales = _nombre.Length > 0
                    ? new string(_nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Select(p => p[0]).Take(2).ToArray()).ToUpperInvariant()
                    : "U";
            }
        }
    }

    private void ToggleDrawer() => _drawerAbierto = !_drawerAbierto;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _drawerAbierto = false;
}
