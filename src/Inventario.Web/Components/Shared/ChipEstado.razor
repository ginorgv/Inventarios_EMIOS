@using Inventario.Domain.ValueObjects

<MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@_color">@_texto</MudChip>

@code {
    [Parameter]
    public EstadoActivo Estado { get; set; }

    private string _texto => Estado switch
    {
        EstadoActivo.Operativo => "Operativo",
        EstadoActivo.Averia => "Avería",
        EstadoActivo.Mantenimiento => "Mantenimiento",
        _ => "Inactivo"
    };

    private Color _color => Estado switch
    {
        EstadoActivo.Operativo => Color.Success,
        EstadoActivo.Averia => Color.Error,
        EstadoActivo.Mantenimiento => Color.Warning,
        _ => Color.Default
    };
}
