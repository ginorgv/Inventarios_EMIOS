@inject Inventario.Infrastructure.Services.ServicioClienteDatos ClienteDatos
@inject ISnackbar Snackbar
@using Inventario.Domain.Entities

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Datos del cliente · @ClienteNombre</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valido">
            <MudTextField T="string" Label="Referencia de contrato" @bind-Value="_modelo.ContractRef"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudSelect T="string" Label="Tipo de proyecto" @bind-Value="_modelo.ProjectType"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                <MudSelectItem T="string" Value="@("solar")">Solar</MudSelectItem>
                <MudSelectItem T="string" Value="@("eólico")">Eólico</MudSelectItem>
                <MudSelectItem T="string" Value="@("BESS")">BESS</MudSelectItem>
                <MudSelectItem T="string" Value="@("híbrido")">Híbrido</MudSelectItem>
                <MudSelectItem T="string" Value="@("industrial")">Industrial</MudSelectItem>
            </MudSelect>
            <MudDatePicker Label="Fecha de inicio" @bind-Date="_modelo.StartDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudDatePicker Label="Fecha de fin (opcional)" @bind-Date="_modelo.EndDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="!_valido" OnClick="Guardar">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    [Parameter]
    public int ClienteId { get; set; }

    [Parameter]
    public string ClienteNombre { get; set; } = string.Empty;

    private readonly ClienteDatos _modelo = new();
    private MudForm? _form;
    private bool _valido;

    protected override async Task OnInitializedAsync()
    {
        _modelo.Id = ClienteId;
        var existente = await ClienteDatos.ObtenerPorClienteIdAsync(ClienteId);
        if (existente is not null)
        {
            _modelo.ContractRef = existente.ContractRef;
            _modelo.ProjectType = existente.ProjectType;
            _modelo.StartDate = existente.StartDate;
            _modelo.EndDate = existente.EndDate;
        }
    }

    private void Cancelar() => Dialog?.Cancel();

    private async Task Guardar()
    {
        if (_form is not null)
            await _form.ValidateAsync();
        if (!_valido)
            return;

        await ClienteDatos.GuardarAsync(_modelo);
        Snackbar.Add("Datos del cliente guardados correctamente.", Severity.Success);
        Dialog?.Close(DialogResult.Ok(_modelo));
    }
}
