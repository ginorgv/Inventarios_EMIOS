@using Inventario.Web.Services
@inject Inventario.Web.Services.IActivoService ActivoService
@inject ISnackbar Snackbar
@inject ILogger<SistemaDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(EsEdicion ? "Editar sistema" : "Nuevo sistema")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valido">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Código *" @bind-Value="Modelo.Codigo"
                                  Required="true" RequiredError="El código es obligatorio." />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Nombre *" @bind-Value="Modelo.Nombre"
                                  Required="true" RequiredError="El nombre es obligatorio." />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="Localización *" @bind-Value="Modelo.LocalizacionId"
                               Required="true" RequiredError="Selecciona una localización.">
                        @foreach (var l in _localizaciones)
                        {
                            <MudSelectItem T="int" Value="@l.Id">@l.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" Label="Activo" @bind-Value="Modelo.Activo" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Descripción" @bind-Value="Modelo.Descripcion" Lines="3" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="!_valido" OnClick="Guardar">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    [Parameter]
    public SistemaViewModel Modelo { get; set; } = new();

    private MudForm? _form;
    private bool _valido;
    private bool _cargando;
    private IReadOnlyList<Inventario.Application.Dtos.LocalizacionDto> _localizaciones =
        Array.Empty<Inventario.Application.Dtos.LocalizacionDto>();

    private bool EsEdicion => Modelo.Id > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _localizaciones = await ActivoService.ListarLocalizacionesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudieron cargar las localizaciones: {ex.Message}", Severity.Error);
        }
    }

    private void Cancelar() => Dialog?.Cancel();

    private async Task Guardar()
    {
        if (_cargando || _form is null)
            return;

        await _form.ValidateAsync();
        if (!_valido)
            return;

        _cargando = true;
        try
        {
            if (EsEdicion)
            {
                await ActivoService.ActualizarSistemaAsync(Modelo);
                Snackbar.Add("Sistema actualizado correctamente.", Severity.Success);
            }
            else
            {
                var id = await ActivoService.CrearSistemaAsync(Modelo);
                Snackbar.Add($"Sistema creado correctamente (id {id}).", Severity.Success);
            }

            Dialog?.Close(DialogResult.Ok(Modelo));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar sistema (código: {Codigo}, nombre: {Nombre})", Modelo.Codigo, Modelo.Nombre);
            Snackbar.Add($"Error al guardar: {ErrorUtil.MensajeRaiz(ex)}", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }
}
